{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ai/chat",
      "destination": "/api/ai/chat"
    },
    {
      "source": "/api/ai/college-tutor",
      "destination": "/api/ai/college-tutor"
    },
    {
      "source": "/api/ai/extract-doc",
      "destination": "/api/ai/extract-doc"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
